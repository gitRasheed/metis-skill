diff --git a/src/main/java/com/acme/pricing/discount/VolumeDiscount.java b/src/main/java/com/acme/pricing/discount/VolumeDiscount.java
new file mode 100644
index 0000000..d5eb450
--- /dev/null
+++ b/src/main/java/com/acme/pricing/discount/VolumeDiscount.java
@@ -0,0 +1,28 @@
+package com.acme.pricing.discount;
+
+import java.math.BigDecimal;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Optional;
+
+/** Percentage off each line, by the highest tier that line's quantity reaches. */
+public class VolumeDiscount extends Discount {
+
+    private final List<VolumeTier> tiers;
+
+    public VolumeDiscount(String code, List<VolumeTier> tiers) {
+        super(code);
+        this.tiers = List.copyOf(tiers);
+    }
+
+    public List<VolumeTier> getTiers() {
+        return tiers;
+    }
+
+    public Optional<BigDecimal> percentFor(int quantity) {
+        return tiers.stream()
+                .filter(tier -> quantity >= tier.minQuantity())
+                .max(Comparator.comparingInt(VolumeTier::minQuantity))
+                .map(VolumeTier::percent);
+    }
+}
