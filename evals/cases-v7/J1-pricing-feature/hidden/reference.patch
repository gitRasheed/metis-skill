@@ -0,0 +1,29 @@
+package com.acme.pricing.repository;
+
+import com.acme.pricing.model.SegmentDiscountRule;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+public class InMemorySegmentRuleRepository implements SegmentRuleRepository {
+
+    private final Map<String, SegmentDiscountRule> rulesBySegment = new LinkedHashMap<>();
+
+    @Override
+    public synchronized void save(SegmentDiscountRule rule) {
+        rulesBySegment.put(rule.segment(), rule);
+    }
+
+    @Override
+    public synchronized Optional<SegmentDiscountRule> findBySegment(String segment) {
+        return Optional.ofNullable(rulesBySegment.get(segment));
+    }
+
+    @Override
+    public synchronized List<SegmentDiscountRule> findAll() {
+        return new ArrayList<>(rulesBySegment.values());
+    }
+}
